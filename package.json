{
  "name": "judgement",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "tunnel": "expo start -c --tunnel",
    "bootstrap": "npm ci && npm --prefix server ci",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && npm --prefix server run typecheck",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test:app && npm --prefix server run test:unit",
    "test:integration": "npm --prefix server run test:integration",
    "test:coverage": "npm run test:app:coverage && npm --prefix server run test:coverage",
    "test:app": "jest",
    "test:app:watch": "jest --watch",
    "test:app:coverage": "jest --coverage",
    "test:server": "npm --prefix server run test",
    "build": "npm run build:server && npm run build:web",
    "build:server": "npm --prefix server run build",
    "build:web": "expo export --platform web --output-dir dist",
    "validate": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run build",
    "ci": "npm run validate"
  },
  "dependencies": {
    "@expo-google-fonts/bangers": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~58.0.15",
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.0",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-clipboard": "~58.0.4",
    "expo-font": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "nativewind": "^4.2.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-css-interop": "^0.2.4",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^3.4.19"
  },
  "private": true,
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^16.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
