    "slug": "judgement",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/logo_kachuful.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.omsinghan25.judgement",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.omsinghan25.judgement"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
