# ---------------------------------------------------------------------------
# Game server environment. Copy to `.env` for local dev; set these as real
# environment variables in your host (Railway / Render / Fly) for production.
# ---------------------------------------------------------------------------

# Port the HTTP + WebSocket server listens on.
# Locally 3001. In production most hosts inject PORT automatically.
PORT=3001

# development | production
NODE_ENV=development

# PostgreSQL connection strings. Supabase gives you both of these under
# Dashboard -> Connect -> ORMs (Prisma). Never use the direct host
# (db.PROJECT_REF.supabase.co) — it is IPv6-only and Railway cannot reach it.
# Both pooler hosts resolve to IPv4.

# Runtime queries. Transaction-mode pooler, port 6543.
# `pgbouncer=true` tells Prisma to disable prepared statements, which the
# transaction pooler does not support.
#   Local    : postgresql://postgres:pass1234@localhost:5432/judgement?schema=public
#   Supabase : postgresql://postgres.PROJECT_REF:PASS@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:pass1234@localhost:5432/judgement?schema=public"

# Schema changes only (`prisma db push`, `prisma migrate`). Session-mode pooler,
# port 5432 — transaction mode cannot run DDL. Referenced as `directUrl` in
# prisma/schema.prisma. Locally this can just repeat DATABASE_URL.
#   Supabase : postgresql://postgres.PROJECT_REF:PASS@aws-0-REGION.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres:pass1234@localhost:5432/judgement?schema=public"

# URL-encode any of @ : / ? # & % that appear in your database password.

# CORS allow-list for the REST API and Socket.IO handshake.
#   "*"                      -> allow any origin (fine for native apps only)
#   "https://play.you.com"   -> single browser origin
#   "https://a.com,https://b.com" -> multiple origins (comma-separated)
# Native (iOS/Android) clients don't send an Origin header, so "*" is harmless
# for them. Lock this down once you have a web build.
CORS_ORIGIN=*

# Performance instrumentation (optional; off unless set). When enabled, logs
# socket transport, per-handler timing, and broadcast payload sizes.
# PERF_LOG=1
# PERF_WARN_MS=100   # handlers slower than this are logged as SLOW

# ---------------------------------------------------------------------------
# Testing (never needed in production)
# ---------------------------------------------------------------------------

# Where the integration tests run. `npm run test:integration` provisions a
# throwaway Postgres via docker-compose.test.yml when this is unset; CI sets it
# to its own service container instead.
#
# Safety rails in server/scripts/test.mjs refuse to run unless the database name
# contains "test" and the host is local, because the integration suite drops and
# recreates the whole schema on every run.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/kachuful_test?schema=public

# Set to 1 only if TEST_DATABASE_URL points at a remote database you are certain
# is disposable. Leave unset otherwise.
# ALLOW_REMOTE_TEST_DB=

# Presentation pauses between tricks, in ms. Defaults are 1000 and 1800; the
# test runner drops both to 1 so a suite is not spent waiting on UI beats.
# LAST_CARD_VIEW_DELAY_MS=
# HAND_WINNER_DURATION_MS=

# Multiplier on bot "thinking time". 1 = the normal human-feeling delay,
# 0 = act immediately (used by tests).
# BOT_SPEED_FACTOR=

# Coverage floors for `npm run test:coverage`. Defaults: 80 / 75 / 80.
# COVERAGE_LINES=
# COVERAGE_BRANCHES=
# COVERAGE_FUNCTIONS=
